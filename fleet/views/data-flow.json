{
  "schema_version": 1,
  "name": "data-flow",
  "description": "How data moves through the fleet: agents -> skills -> models -> knowledge",
  "layout": "tree",
  "sources": ["supervisor", "rag", "knowledge", "universe"],
  "edges": [
    {"from": "supervisor:agent", "to": "rag:query", "type": "queries"},
    {"from": "rag:chunk", "to": "autoresearch:dataset", "type": "feeds"},
    {"from": "supervisor:supervisor", "to": "federation:fleet", "type": "federates"}
  ],
  "metrics_overlay": ["tok_s"],
  "animation": {"queries": "flow", "feeds": "flow", "assigned": "flow", "runs": "flow", "writes": "flow", "reads": "flow"},
  "zoom_breakpoints": {"labels": 0.4, "metrics": 0.6, "animation": 0.8}
}
